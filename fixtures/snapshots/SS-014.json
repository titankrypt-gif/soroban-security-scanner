    {
      "rule_id": "SS-014",
      "title": "Token transfer amount without validation",
      "description": "A public contract entry point passes a caller-supplied amount to `transfer` or `transfer_from` without comparing it against zero. Token implementations differ in how they treat negative or out-of-range amounts; a missing guard can therefore move an unintended value, corrupt accounting, or revert in surprising ways. This is a heuristic: it cannot prove that the token rejects the value or that another layer validates it, so it reports low confidence.",
      "severity": "medium",
      "confidence": "low",
      "category": "token",
      "location": {
        "file": "SS-014/positive.rs",
        "line": 18,
        "column": 9
      },
      "evidence": "`transfer` transfers unchecked amount `amount` in entry point `payout`",
      "remediation": "Validate the amount before transferring, for example reject `amount <= 0` with a typed contract error (or check both bounds when the token has a maximum). Validate once at the entry point and pass the checked value to `transfer`/`transfer_from`.",
      "references": [
        "https://developers.stellar.org/docs/tokens/token-interface",
        "https://developers.stellar.org/docs/learn/encyclopedia/security"
      ],
      "fingerprint": "1a0210bc82d9870ef2668c400ed7b078"
    }
