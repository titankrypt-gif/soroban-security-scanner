  "findings": [
    {
      "rule_id": "SS-003",
      "title": "Unbounded storage iteration in an entry point",
      "description": "A contract entry point iterates over storage. If the iterated collection grows without bound, the operation's resource cost grows with it and may exceed Soroban's ledger entry, CPU, or memory limits, causing the entry point to fail (a denial of service). Soroban does not provide storage enumeration in the same way as some platforms, so patterns that loop over persistent collections built by the contract are the usual cause.",
      "severity": "medium",
      "confidence": "low",
      "category": "resource-usage",
      "location": {
        "file": "SS-003/positive.rs",
        "line": 10,
        "column": 21
      },
      "evidence": "storage iteration in `count_all`: env . storage () . persistent () . keys ()",
      "remediation": "Bound the amount of work performed per invocation: paginate with an explicit limit, maintain aggregate values instead of scanning, or cap the number of entries processed and return partial results. Ensure any loop over storage is bounded by a value the contract controls.",
      "references": [
        "https://developers.stellar.org/docs/learn/encyclopedia/security/resource-limits"
      ],
      "fingerprint": "5e9cc67f552405f3b43ab581c05a9949"
    }
