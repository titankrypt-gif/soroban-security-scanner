    {
      "rule_id": "SS-029",
      "title": "Public test or debug hook in a contract entry point",
      "description": "A public contract entry point is named like a test or debug backdoor (a `test`, `debug`, `dev`, `mock`, or `dummy` name segment). Backdoor entry points that remain callable in a production deployment let anyone invoke privileged behavior, and are a well-known way on-chain contracts are compromised. This is a name-based heuristic and may flag a legitimately named function.",
      "severity": "medium",
      "confidence": "medium",
      "category": "access-control",
      "location": {
        "file": "SS-029/positive.rs",
        "line": 14,
        "column": 9
      },
      "evidence": "public entry point `debug_set_admin` looks like a test/debug hook",
      "remediation": "Remove test/debug entry points before deployment, or gate them behind `#[cfg(test)]` or a compile-time feature so they cannot be called from a production build. Never ship a privileged function intended only for testing.",
      "references": [
        "https://developers.stellar.org/docs/learn/encyclopedia/security"
